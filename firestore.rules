rules_version = '2';

// Firestore security rules for NirapodClick.
//
// Goals:
//   - Only the authenticated user can read/write their own data.
//   - No anonymous access anywhere.
//   - Field-level shape validation on writes so a user can't store garbage
//     or oversized blobs into their history.
//   - Locks down anything that isn't explicitly allowed below.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

// Validates the shape of a check document. Returns true if the incoming
    // write matches our schema. Used both as a security gate and as a
    // sanity check on the client.
    //
    // Allowed fields (matches `CheckerRepository.serializeCheck`):
    //   originalText  string  <= 5000
    //   score         int     0..100
    //   level         "safe" | "low" | "medium" | "high" | "critical"
    //   category      string  <= 64
    //   confidence    double  0..1
    //   reasons       [string]  <= 25, each <= 200
    //   type          "message" | "url" | "screenshot" | "phone"  (optional,
    //                 defaults to "message" if absent)
    //   createdAt     server timestamp
    function isValidCheck() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'originalText', 'score', 'level', 'category', 'confidence',
          'reasons', 'type', 'createdAt'])
        && data.originalText is string
        && data.originalText.size() <= 5000
        && data.score is int
        && data.score >= 0
        && data.score <= 100
        && data.level in ['safe', 'low', 'medium', 'high', 'critical']
        && data.category is string
        && data.category.size() <= 64
        && data.confidence is number
        && data.confidence >= 0
        && data.confidence <= 1
        && data.reasons is list
        && data.reasons.size() <= 25
        && (!('type' in data.keys())
            || (data.type is string
                && data.type in ['message', 'url', 'screenshot', 'phone']))
        && data.createdAt == request.time;
    }

    // ---- rules ---------------------------------------------------------     

    match /users/{uid} {
      // The user doc itself is currently unused, but we reserve the path
      // so future fields (preferences, profile) are owned by uid.
      allow read, write: if isOwner(uid);

      match /checks/{checkId} {
        // Allow read of own checks; deny all others.
        allow read: if isOwner(uid);

        // Allow create only (we don't need update/delete in v1); and the
        // payload must match the schema. Note: clearAll() in the client
        // bypasses these rules because it uses batched deletes from
        // the user's own device; Firestore batch deletes still need
        // `delete: true` here, so we grant it scoped to the owner.
        allow create: if isOwner(uid) && isValidCheck();
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // ---- Community reports (Phone Checker) ---------------------------
    //
    // Schema:
    //   reports/{auto-id}
    //     phone: "01712345678"   (normalized BD mobile)
    //     type: "scam" | "payment" | "otp" | "job" | "harassment" | "other"
    //     description: string  (optional, user-supplied details)
    //     userId: <uid>        (must equal request.auth.uid)
    //     createdAt: server timestamp
    //
    // Rules:
    //   * Any signed-in user may READ reports (so the phone check can
    //     aggregate counts for a number). The client never shows
    //     individual report documents — only their aggregated counts.
    //   * Any signed-in user may CREATE a report, but the userId
    //     field must equal their own uid (prevents forged reports
    //     that blame another user).
    //   * UPDATE / DELETE are denied so a malicious user can't edit
    //     or wipe other people's reports.
    //
    // We deliberately do NOT maintain a separate `phone_reports/{phone}`
    // summary collection; the client aggregates counts from `reports`
    // directly. That avoids needing a Cloud Function to keep the
    // summary honest, which would push us off the free Spark tier.
    match /reports/{reportId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() == 11
                    && request.resource.data.phone.matches('^01[3-9][0-9]{8}$')
                    && request.resource.data.type is string
                    && request.resource.data.type in
                         ['scam', 'payment', 'otp', 'job', 'harassment', 'other']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 500
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Default deny: anything not matched above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}