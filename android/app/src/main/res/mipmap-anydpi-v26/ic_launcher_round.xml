<?xml version="1.0" encoding="utf-8"?>
<!--
  Same adaptive-icon layers as ic_launcher.xml. Some launchers (and older
  Android versions) reference @mipmap/ic_launcher_round instead of
  @mipmap/ic_launcher; pointing both at the same adaptive-icon stack keeps
  a single visual identity without duplicating raster assets.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="20%" />
    </foreground>
</adaptive-icon>